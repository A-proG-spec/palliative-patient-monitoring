{
  "name": "backend",
  "version": "1.0.0",
  "description": "",
  "main": "dist/server.js",
  "type": "module",
  "scripts": {
    "build": "prisma generate && tsc && tsc-alias",
    "start": "node dist/server.js",
    "dev": "nodemon --exec tsx src/server.ts",
    "seed": "tsx prisma/seed.ts",
    "seed:prod": "node dist/prisma/seed.js",
    "test": "vitest",
    "test:watch": "vitest --watch",
    "typecheck": "tsc --noEmit",
