  suspectedAdrReaction String?
  adrSeverity          PharmacistAdrSeverity?
  adrManagement        PharmacistAdrAction[]  @default([])

  // Constipation
  bowelFunction   PharmacistBowelFunction?
  laxativeUse     Boolean                  @default(false)
  laxativeDetails String?

  // Dose adjustment
  doseAdjustmentRequired Boolean                          @default(false)
  doseAdjustmentReasons  PharmacistDoseAdjustmentReason[] @default([])

  // Counselling
  patientUnderstanding PharmacistPatientUnderstanding?
  counselingTopics     PharmacistCounselingTopic[]     @default([])

  // Plan
