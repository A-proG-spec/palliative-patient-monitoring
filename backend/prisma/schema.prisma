  updatedByAdmin Admin?   @relation("NutritionalUpdatedBy", fields: [updatedBy], references: [id])

  deletedAt      DateTime?
  deletedBy      Int?
  deletedByAdmin Admin?    @relation("NutritionalDeletedBy", fields: [deletedBy], references: [id])
  deletionReason String?

  dietaryRecall NutritionalDietaryRecall[]
  labResults    NutritionalLabResult[]

  @@index([patientId])
  @@index([createdBy])
  @@index([createdAt])
}

model NutritionalDietaryRecall {
  id                      Int                   @id @default(autoincrement())
  nutritionalAssessmentId Int
  nutritionalAssessment   NutritionalAssessment @relation(fields: [nutritionalAssessmentId], references: [id], onDelete: Cascade)

  mealType String
  contents String?

  @@index([nutritionalAssessmentId])
}

model NutritionalLabResult {
  id                      Int                   @id @default(autoincrement())
  nutritionalAssessmentId Int
  nutritionalAssessment   NutritionalAssessment @relation(fields: [nutritionalAssessmentId], references: [id], onDelete: Cascade)

  test      NutritionLabTest
  testOther String?
  result    String?

  @@index([nutritionalAssessmentId])
}

// ═════════════════════════════════════════════════════════════
// 18. PAIN ASSESSMENT
// ═════════════════════════════════════════════════════════════
model PainAssessment {
  id        Int     @id @default(autoincrement())
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  assessmentType PainAssessmentType

  // Pain history
  primaryPainComplaint String?
  painOnset            PainOnset?
  painDuration         String?

  painLocations     PainLocation[]    @default([])
  painLocationOther String?
  painDescriptions  PainDescription[] @default([])

  // Severity (0–10 NRS)
  currentPainScore Int?
  worstPainLast24h Int?
  leastPainLast24h Int?

  // Type & pattern
  painType    PainType[]    @default([])
  painPattern PainPattern[] @default([])

  // Aggravating & relieving factors
  aggravatingFactors PainAggravatingFactor[] @default([])
  relievingFactors   PainRelievingFactor[]   @default([])
  relievingOther     String?

  // Opioid use
  opioidUse PainOpioidUse?

  // Adjuvant drugs
  adjuvantDrugs PainAdjuvantDrug[] @default([])

  // Breakthrough pain
  breakthroughFrequency PainBreakthroughFrequency?
  rescueMedicationUsed  Boolean?
  rescueEffectiveness   PainRescueEffectiveness?

  // Associated symptoms
  associatedSymptoms PainAssociatedSymptom[] @default([])

  // Clinical observation
  patientBehaviors PainPatientBehavior[] @default([])

  // Barriers
  managementBarriers     PainManagementBarrier[] @default([])
  managementBarrierOther String?

  // Diagnosis
  diagnosis PainDiagnosis[] @default([])

  // Management plan
  managementGoals           String?
  interventions             PainIntervention[]             @default([])
  nonPharmacologicalMethods PainNonPharmacologicalMethod[] @default([])
  monitoringPlan            PainMonitoringPlan[]           @default([])

  // Summary
  assessmentOutcome    PainAssessmentOutcome[]   @default([])
  finalRecommendations PainFinalRecommendation[] @default([])

  // Audit
  createdBy      Int
  createdByStaff Staff @relation("PainCreatedBy", fields: [createdBy], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Int?
  updatedByAdmin Admin?   @relation("PainUpdatedBy", fields: [updatedBy], references: [id])

  deletedAt      DateTime?
  deletedBy      Int?
  deletedByAdmin Admin?    @relation("PainDeletedBy", fields: [deletedBy], references: [id])
  deletionReason String?

  impacts PainImpact[]

  @@index([patientId])
  @@index([createdBy])
  @@index([createdAt])
}

model PainImpact {
  id               Int            @id @default(autoincrement())
  painAssessmentId Int
  painAssessment   PainAssessment @relation(fields: [painAssessmentId], references: [id], onDelete: Cascade)

  area     PainImpactArea
  severity PainImpactSeverity?

  @@index([painAssessmentId])
}

// ═════════════════════════════════════════════════════════════
// 19. SOCIAL ASSESSMENT
// ═════════════════════════════════════════════════════════════
model SocialAssessment {
  id        Int     @id @default(autoincrement())
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  assessmentType SocialAssessmentType

  // Family composition
  householdSize          Int?
  livingArrangement      SocialLivingArrangement?
  livingArrangementOther String?

  // Caregiver
  caregiverAvailability  SocialCaregiverAvailability?
  caregiverHealth        SocialCaregiverHealth?
  caregiverUnderstanding SocialCaregiverUnderstanding?
  caregiverStress        SocialCaregiverStress?

  // Social support
  familySupport    SocialFamilySupport?
  communitySupport SocialCommunitySupport[] @default([])
  contactFrequency SocialContactFrequency?
  isolationRisk    SocialIsolationRisk?

  // Financial
  incomeSources           SocialIncomeSource[]       @default([])
  incomeSourceOther       String?
  monthlyHouseholdIncome  SocialMonthlyIncome?
  financialChallenges     SocialFinancialChallenge[] @default([])
  financialChallengeOther String?
  financialRiskLevel      SocialFinancialRisk?

  // Housing
  residenceType            SocialResidenceType?
  residenceTypeOther       String?
  homeEnvironment          SocialHomeEnvironment?
  utilitiesAccess          Json                            @default("{}")
  homeBasedCareSuitability SocialHomeBasedCareSuitability?

  // Transportation
  transportAccess            SocialTransportAccess[]    @default([])
  distanceToHealthFacilityKm Float?
  transportChallenges        SocialTransportChallenge[] @default([])
  transportChallengeOther    String?

  // Employment & education
  employmentStatus SocialEmploymentStatus?
  educationLevel   SocialEducationLevel?

  // Cultural & spiritual
  religiousAffiliation         SocialReligiousAffiliation?
  religiousAffiliationOther    String?
  spiritualSupportAvailable    Boolean?
  culturalFactorsAffectingCare String?

  // Legal & advocacy
  hasLegalRepresentative     Boolean?
  advanceDirectivesAvailable Boolean?
  legalConcerns              SocialLegalConcern[] @default([])
  legalConcernOther          String?

  // Bereavement risk
  familyPreparedForPrognosis SocialFamilyPreparedness?
  anticipatoryGrief          SocialAnticipatoryGrief?
  bereavementRisk            SocialBereavementRisk?
  familyRequiresSupport      Boolean?

  // Social work assessment
  majorSocialIssues          SocialMajorIssue[] @default([])
  majorSocialIssueOther      String?
  strengthsAndResources      String?
  areasRequiringIntervention String?

  // Care plan
  plannedInterventions     SocialCarePlanIntervention[] @default([])
  plannedInterventionOther String?
  followUpPlan             String?

  // Summary
  assessmentOutcome SocialAssessmentOutcome[] @default([])

  // Audit
  createdBy      Int
  createdByStaff Staff @relation("SocialCreatedBy", fields: [createdBy], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Int?
  updatedByAdmin Admin?   @relation("SocialUpdatedBy", fields: [updatedBy], references: [id])

  deletedAt      DateTime?
  deletedBy      Int?
  deletedByAdmin Admin?    @relation("SocialDeletedBy", fields: [deletedBy], references: [id])
  deletionReason String?

  householdMembers SocialHouseholdMember[]

  @@index([patientId])
  @@index([createdBy])
  @@index([createdAt])
}

model SocialHouseholdMember {
  id                 Int              @id @default(autoincrement())
  socialAssessmentId Int
  socialAssessment   SocialAssessment @relation(fields: [socialAssessmentId], references: [id], onDelete: Cascade)

  name         String?
  relationship String?
  age          Int?
  occupation   String?

  @@index([socialAssessmentId])
}

// ═════════════════════════════════════════════════════════════
// 20. SPIRITUAL ASSESSMENT
// ═════════════════════════════════════════════════════════════
model SpiritualAssessment {
  id        Int     @id @default(autoincrement())
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  assessmentType SpiritualAssessmentType

  // Religious / spiritual background
  religiousAffiliation      SpiritualReligiousAffiliation?
  religiousAffiliationOther String?
  faithImportance           SpiritualFaithImportance?
  activityParticipation     SpiritualActivityParticipation?
  placeOfWorship            String?

  // Spiritual support system
  supportSources SpiritualSupportSource[] @default([])

  religiousLeaderName         String?
  religiousLeaderOrganization String?
  religiousLeaderPhone        String?

  // Spiritual beliefs and values
  lifeMeaningAndPurpose String?
  sourcesOfStrength     String?

  practicesToContinue        Boolean?
  practicesToContinueDetails String?

  ritualsToRespect        Boolean?
  ritualsToRespectDetails String?

  // Spiritual distress assessment
  spiritualDistressLevel       SpiritualDistressLevel?
  spiritualConcernsDescription String?

  // Hope and coping assessment
  currentHopes      String?
  copingMethods     SpiritualCopingMethod[] @default([])
  copingMethodOther String?
  feelsAtPeace      SpiritualPeaceStatus?

  // Family and spiritual needs
  familySharesBeliefs      SpiritualFamilySharesBeliefs?
  familyBenefitFromSupport Boolean?
  familySpiritualConcerns  String?

  // End-of-life spiritual preferences
  preferredEndOfLifeCare       SpiritualEndOfLifeCare[]        @default([])
  preferredEndOfLifeCareOther  String?
  preferredPlaceOfCare         SpiritualPreferredPlaceOfCare?
  preferredPlaceOfCareOther    String?
  preferredPlaceOfDeath        SpiritualPreferredPlaceOfDeath?
  religiousPracticesAfterDeath String?

  // Spiritual strengths
  patientStrengths     SpiritualPatientStrength[] @default([])
  patientStrengthOther String?
  additionalStrengths  String?

  // Spiritual care plan
  identifiedNeeds      SpiritualIdentifiedNeed[]  @default([])
  identifiedNeedOther  String?
  plannedInterventions String?
  followUpSchedule     SpiritualFollowUpSchedule?

  // Provider assessment
  summaryOfAssessment   String?
  providerDistressLevel SpiritualDistressLevel?
  recommendedServices   SpiritualRecommendedService[] @default([])
  assessmentOutcome     SpiritualAssessmentOutcome[]  @default([])

  // Audit
  createdBy      Int
  createdByStaff Staff @relation("SpiritualCreatedBy", fields: [createdBy], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Int?
  updatedByAdmin Admin?   @relation("SpiritualUpdatedBy", fields: [updatedBy], references: [id])

  deletedAt      DateTime?
  deletedBy      Int?
  deletedByAdmin Admin?    @relation("SpiritualDeletedBy", fields: [deletedBy], references: [id])
  deletionReason String?

  distressConcerns SpiritualDistressConcern[]

  @@index([patientId])
  @@index([createdBy])
  @@index([createdAt])
}

model SpiritualDistressConcern {
  id                    Int                 @id @default(autoincrement())
  spiritualAssessmentId Int
  spiritualAssessment   SpiritualAssessment @relation(fields: [spiritualAssessmentId], references: [id], onDelete: Cascade)

  concern SpiritualDistressConcernType
  present Boolean                      @default(false)

  @@index([spiritualAssessmentId])
}

// ═════════════════════════════════════════════════════════════
// 21. PSYCHIATRY ASSESSMENT
// ═════════════════════════════════════════════════════════════
model PsychiatryAssessment {
  id        Int     @id @default(autoincrement())
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  assessmentType PsychiatryAssessmentType

  // Presenting problem
  reasonForReferral String?
  currentSymptoms   PsychiatrySymptom[] @default([])
  symptomOther      String?
  onsetAndDuration  String?
  severity          PsychiatrySeverity?

  // Mental state examination
  appearanceBehavior PsychiatryAppearanceBehavior[] @default([])
  speech             PsychiatrySpeech?
  mood               PsychiatryMood?
  affect             PsychiatryAffect?
  thoughtProcess     PsychiatryThoughtProcess[]     @default([])
  thoughtContent     PsychiatryThoughtContent[]     @default([])
  perception         PsychiatryPerception[]         @default([])
  cognition          PsychiatryCognition[]          @default([])
  insightJudgment    PsychiatryInsightJudgment?

  // Suicide risk assessment
  suicidalIdeation  PsychiatrySuicidalIdeation?
  suicideRiskLevel  PsychiatrySuicideRiskLevel?
  protectiveFactors PsychiatryProtectiveFactor[] @default([])

  // Organic causes
  organicCauses                   PsychiatryOrganicCause[] @default([])
  medicationsAffectingMentalState String?

  // Sleep & appetite
  sleepPattern PsychiatrySleepPattern?
  appetite     PsychiatryAppetite?

  // Functional & social
  dailyFunctioning PsychiatryDailyFunctioning?
  socialWithdrawal PsychiatrySocialWithdrawal?

  // Diagnosis
  diagnoses      PsychiatryDiagnosis[] @default([])
  diagnosisOther String?

  // Management plan
  immediateInterventions PsychiatryImmediateIntervention[]  @default([])
  pharmacologicalPlan    PsychiatryPharmacologicalPlan[]    @default([])
  nonPharmacologicalPlan PsychiatryNonPharmacologicalPlan[] @default([])
  monitoringPlan         PsychiatryMonitoringPlan[]         @default([])

  // Family & caregiver
  familyDistressLevel    PsychiatryFamilyDistressLevel?
  caregiverBurnout       Boolean?
  familyCounselingNeeded Boolean?

  // Summary
  assessmentOutcome    PsychiatryAssessmentOutcome[]   @default([])
  finalRecommendations PsychiatryFinalRecommendation[] @default([])

  // Audit
  createdBy      Int
  createdByStaff Staff @relation("PsychiatryCreatedBy", fields: [createdBy], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Int?
  updatedByAdmin Admin?   @relation("PsychiatryUpdatedBy", fields: [updatedBy], references: [id])

  deletedAt      DateTime?
  deletedBy      Int?
  deletedByAdmin Admin?    @relation("PsychiatryDeletedBy", fields: [deletedBy], references: [id])
  deletionReason String?

  @@index([patientId])
  @@index([createdBy])
  @@index([createdAt])
}
