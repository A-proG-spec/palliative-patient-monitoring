// ─────────────────────────────────────────────────────────────
// Prisma Schema — Palliative Care Backend
// Migrated from MongoDB (Mongoose) → PostgreSQL
// ─────────────────────────────────────────────────────────────

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

