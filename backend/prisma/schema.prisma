// ═════════════════════════════════════════════════════════════
// 9. HOSPITAL ADMISSION
// ═════════════════════════════════════════════════════════════
model HospitalAdmission {
  id Int @id @default(autoincrement())

  // Patient reference
  patientId         Int
  patient           Patient @relation(fields: [patientId], references: [id])
  hospitalPatientId String?

  // Section 2 — referral info
  referralId          Int?
