// ═════════════════════════════════════════════════════════════
// 1. ADMIN
// ═════════════════════════════════════════════════════════════
model Admin {
  id        Int      @id @default(autoincrement())
  name      String
  email     String   @unique
  password  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations (existing)
  approvedReferrals                Referral[]                 @relation("ReferralApprovedBy")
  staffAssigned                    Staff[]                    @relation("StaffAssignedBy")
  patientsUpdated                  Patient[]                  @relation("PatientUpdatedBy")
  visitsUpdated                    HomeVisit[]                @relation("VisitUpdatedBy")
  visitsDeleted                    HomeVisit[]                @relation("VisitDeletedBy")
  admissionsUpdated                HospitalAdmission[]        @relation("AdmissionUpdatedBy")
  admissionsDeleted                HospitalAdmission[]        @relation("AdmissionDeletedBy")
  imagingUpdated                   ImagingOrder[]             @relation("ImagingUpdatedBy")
  imagingDeleted                   ImagingOrder[]             @relation("ImagingDeletedBy")
  labsUpdated                      LaboratoryTest[]           @relation("LabUpdatedBy")
  labsDeleted                      LaboratoryTest[]           @relation("LabDeletedBy")
  medicationsUpdated               Medication[]               @relation("MedicationUpdatedBy")
  medicationsDeleted               Medication[]               @relation("MedicationDeletedBy")
  progressNotesUpdated             PatientProgressNote[]      @relation("ProgressNoteUpdatedBy")
  progressNotesDeleted             PatientProgressNote[]      @relation("ProgressNoteDeletedBy")
  dischargeUpdated                 DischargeSummary[]         @relation("DischargeUpdatedBy")
  dischargeDeleted                 DischargeSummary[]         @relation("DischargeDeletedBy")
  staffUpdated                     Staff[]                    @relation("StaffUpdatedBy")
  staffDeleted                     Staff[]                    @relation("StaffDeletedBy")
  hospiceNursingAssessments        HospiceNursingAssessment[] @relation("HospiceNursingUpdatedBy")
  hospiceNursingDeletedAssessments HospiceNursingAssessment[] @relation("HospiceNursingDeletedBy")

  // Relations (assessment update/delete audit)
  clinicalPharmacistUpdated ClinicalPharmacistAssessment[] @relation("ClinicalPharmacistUpdatedBy")
  clinicalPharmacistDeleted ClinicalPharmacistAssessment[] @relation("ClinicalPharmacistDeletedBy")
  physiotherapyUpdated      PhysiotherapyAssessment[]      @relation("PhysiotherapyUpdatedBy")
  physiotherapyDeleted      PhysiotherapyAssessment[]      @relation("PhysiotherapyDeletedBy")
  familyAssessmentUpdated   FamilyAssessment[]             @relation("FamilyAssessmentUpdatedBy")
  familyAssessmentDeleted   FamilyAssessment[]             @relation("FamilyAssessmentDeletedBy")
  nutritionalUpdated        NutritionalAssessment[]        @relation("NutritionalUpdatedBy")
  nutritionalDeleted        NutritionalAssessment[]        @relation("NutritionalDeletedBy")
  painUpdated               PainAssessment[]               @relation("PainUpdatedBy")
  painDeleted               PainAssessment[]               @relation("PainDeletedBy")
  socialUpdated             SocialAssessment[]             @relation("SocialUpdatedBy")
  socialDeleted             SocialAssessment[]             @relation("SocialDeletedBy")
  spiritualUpdated          SpiritualAssessment[]          @relation("SpiritualUpdatedBy")
  spiritualDeleted          SpiritualAssessment[]          @relation("SpiritualDeletedBy")
  psychiatryUpdated         PsychiatryAssessment[]         @relation("PsychiatryUpdatedBy")
  psychiatryDeleted         PsychiatryAssessment[]         @relation("PsychiatryDeletedBy")
}

// ═════════════════════════════════════════════════════════════
// 2. STAFF
// ═════════════════════════════════════════════════════════════
model Staff {
  id                           Int         @id @default(autoincrement())
  name                         String
  email                        String      @unique
  phone                        String
  password                     String
  role                         StaffRole?
  status                       StaffStatus @default(Pending)
  isEmailVerified              Boolean     @default(false)
  emailVerificationOtp         String?
  emailVerificationOtpExpires  DateTime?
  emailVerificationOtpAttempts Int         @default(0)
  assignedBy                   Int?
  assignedByAdmin              Admin?      @relation("StaffAssignedBy", fields: [assignedBy], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Soft delete
  deletedAt      DateTime?
  deletedBy      Int?
  deletedByAdmin Admin?    @relation("StaffDeletedBy", fields: [deletedBy], references: [id])
  deletionReason String?
  updatedBy      Int?
  updatedByAdmin Admin?    @relation("StaffUpdatedBy", fields: [updatedBy], references: [id])

  // Relations (as actor) — existing
  patientsRegistered       Patient[]                  @relation("PatientRegisteredBy")
  visitsCreated            HomeVisit[]                @relation("VisitCreatedBy")
  visitSignatures          HomeVisitSignature[]
  medicationsPrescribed    Medication[]               @relation("MedicationPrescribedBy")
  medicationsUpdated       Medication[]               @relation("MedicationUpdatedByStaff")
  labsOrdered              LaboratoryTest[]           @relation("LabOrderedBy")
  imagingOrdered           ImagingOrder[]             @relation("ImagingOrderedBy")
  referralsRequested       Referral[]                 @relation("ReferralRequestedBy")
  admissionsCreated        HospitalAdmission[]        @relation("AdmissionCreatedBy")
  dischargeCreated         DischargeSummary[]         @relation("DischargeCreatedBy")
  progressNotesCreated     PatientProgressNote[]      @relation("ProgressNoteCreatedBy")
  progressNotesResponsible PatientProgressNote[]      @relation("ProgressNoteResponsible")
  progressNoteSignatures   ProgressNoteSignature[]
  hospiceNursingCreated    HospiceNursingAssessment[] @relation("HospiceNursingCreatedBy")
  hospiceNursingAssessed   HospiceNursingAssessment[] @relation("HospiceNursingAssessedBy")

  // Relations (as actor) — assessment creations
  clinicalPharmacistCreated ClinicalPharmacistAssessment[] @relation("ClinicalPharmacistCreatedBy")
  physiotherapyCreated      PhysiotherapyAssessment[]      @relation("PhysiotherapyCreatedBy")
  familyAssessmentCreated   FamilyAssessment[]             @relation("FamilyAssessmentCreatedBy")
  nutritionalCreated        NutritionalAssessment[]        @relation("NutritionalCreatedBy")
  painCreated               PainAssessment[]               @relation("PainCreatedBy")
  socialCreated             SocialAssessment[]             @relation("SocialCreatedBy")
  spiritualCreated          SpiritualAssessment[]          @relation("SpiritualCreatedBy")
  psychiatryCreated         PsychiatryAssessment[]         @relation("PsychiatryCreatedBy")

  @@index([status])
  @@index([isEmailVerified])
  @@index([emailVerificationOtpExpires])
  @@index([role])
  @@index([deletedAt])
}

// ═════════════════════════════════════════════════════════════
// 3. PATIENT
// ═════════════════════════════════════════════════════════════
model Patient {
  id                    Int             @id @default(autoincrement())
  firstName             String
  lastName              String
  age                   Int
  sex                   Sex
  dateOfBirth           DateTime
  address               String
  phone                 String
  emergencyContactName  String
  emergencyContactPhone String
  caregiverName         String
  caregiverPhone        String
  caregiverRelation     String?
  primaryDiagnosis      String
  secondaryDiagnoses    String[]        @default([])
  diseaseStage          DiseaseStage
  comorbidities         String[]        @default([])
  estimatedPrognosis    Prognosis
  status                PatientStatus   @default(Active)
  currentLocation       CurrentLocation @default(Home)
  hospitalPatientId     String?

  registeredBy      Int
  registeredByStaff Staff @relation("PatientRegisteredBy", fields: [registeredBy], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Int?
  updatedByAdmin Admin?   @relation("PatientUpdatedBy", fields: [updatedBy], references: [id])

  // Relations (existing)
  visits                    HomeVisit[]
  medications               Medication[]
  labTests                  LaboratoryTest[]
  referrals                 Referral[]
  admissions                HospitalAdmission[]
  dischargeSummaries        DischargeSummary[]
  progressNotes             PatientProgressNote[]
  imagingOrders             ImagingOrder[]
  labResults                LabResult[]
  hospiceNursingAssessments HospiceNursingAssessment[]

  // Relations (assessments)
  clinicalPharmacistAssessments ClinicalPharmacistAssessment[]
  physiotherapyAssessments      PhysiotherapyAssessment[]
  familyAssessments             FamilyAssessment[]
  nutritionalAssessments        NutritionalAssessment[]
  painAssessments               PainAssessment[]
  socialAssessments             SocialAssessment[]
  spiritualAssessments          SpiritualAssessment[]
  psychiatryAssessments         PsychiatryAssessment[]

  @@index([status])
  @@index([currentLocation])
  @@index([registeredBy])
}

// ═════════════════════════════════════════════════════════════
// 4. MEDICATION
// ═════════════════════════════════════════════════════════════
model Medication {
  id                Int                      @id @default(autoincrement())
  patientId         Int
  patient           Patient                  @relation(fields: [patientId], references: [id])
  name              String
