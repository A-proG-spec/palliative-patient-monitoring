  @@index([homeVisitId])
  @@index([staffId])
  @@index([homeVisitId, isTeamLeader])
}

// ── HomeVisit child: current medications ──
model HomeVisitMedication {
  id          Int       @id @default(autoincrement())
  homeVisitId Int
