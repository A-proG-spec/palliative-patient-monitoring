  financialBarriers      Boolean                           @default(false)
  pharmacyIntervention   Boolean                           @default(false)

  // Summary
  pharmacistSummary      String?
  summaryFlags           PharmacistSummaryFlag[]         @default([])
  finalRecommendations   PharmacistFinalRecommendation[] @default([])
  clinicalPharmacistName String?

  // Audit
  createdBy      Int
  createdByStaff Staff @relation("ClinicalPharmacistCreatedBy", fields: [createdBy], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Int?
  updatedByAdmin Admin?   @relation("ClinicalPharmacistUpdatedBy", fields: [updatedBy], references: [id])

  deletedAt      DateTime?
  deletedBy      Int?
  deletedByAdmin Admin?    @relation("ClinicalPharmacistDeletedBy", fields: [deletedBy], references: [id])
  deletionReason String?

