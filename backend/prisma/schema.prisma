  // Section 13 — nursing / supportive care
  nursingSupportiveCareProvided ProgressNoteNursingCare[] @default([])
  nursingSupportiveCareOther    String?                   @default("")
  responseToSupportiveCare      String?                   @default("")

  // Section 14 — investigations
  investigationsPerformedReviewed      ProgressNoteInvestigation[] @default([])
  investigationsPerformedReviewedOther String?                     @default("")
  significantResults                   String?                     @default("")
  clinicalSignificanceActionTaken      String?                     @default("")

  // Section 16 — clinical assessment
  overallAssessment       String?  @default("")
  problemsIdentifiedToday String[] @default([])

  // Section 17 — plan
  symptomManagementPlan            String? @default("")
  medicationPlan                   String? @default("")
  nursingSupportiveCarePlan        String? @default("")
  investigationsMonitoring         String? @default("")
  familyCaregiverPlan              String? @default("")
  referralsConsultations           String? @default("")
  dischargeTransferHospicePlanning String? @default("")

  // Section 18 — SOAP
  soapSubjective String? @default("")
  soapObjective  String? @default("")
  soapAssessment String? @default("")
  soapPlan       String? @default("")

  // Section 20 — authorization
  responsibleClinicianId Int
  responsibleClinician   Staff @relation("ProgressNoteResponsible", fields: [responsibleClinicianId], references: [id])

  facilityStamp String? @default("")

  // Meta
  createdBy      Int
  createdByStaff Staff @relation("ProgressNoteCreatedBy", fields: [createdBy], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Int?
  updatedByAdmin Admin?   @relation("ProgressNoteUpdatedBy", fields: [updatedBy], references: [id])

  deletedAt      DateTime?
  deletedBy      Int?
  deletedByAdmin Admin?    @relation("ProgressNoteDeletedBy", fields: [deletedBy], references: [id])
  deletionReason String?

  // Children
  medications                 ProgressNoteMedication[]
  signatures                  ProgressNoteSignature[]
  multidisciplinaryTeamReview ProgressNoteMDTReview[]
  additionalProgressNotes     ProgressNoteAdditionalNote[]

  @@index([patientId, createdAt])
  @@index([admissionId, createdAt])
  @@index([createdBy])
  @@index([responsibleClinicianId])
}

// ── ProgressNote child: medications ──
model ProgressNoteMedication {
  id             Int                 @id @default(autoincrement())
  progressNoteId Int
  progressNote   PatientProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)

  medicationTreatment String? @default("")
  dose                String? @default("")
  route               String? @default("")
  frequency           String? @default("")
  reasonResponse      String? @default("")

  @@index([progressNoteId])
}

// ── ProgressNote child: signatures ──
model ProgressNoteSignature {
  id             Int                 @id @default(autoincrement())
  progressNoteId Int
  progressNote   PatientProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)

  staffId  Int
  staff    Staff                     @relation(fields: [staffId], references: [id])
  name     String
  role     ProgressNoteSignatureRole
  signedAt DateTime                  @default(now())

  @@index([progressNoteId])
  @@index([staffId])
}

// ── ProgressNote child: MDT review ──
model ProgressNoteMDTReview {
  id             Int                 @id @default(autoincrement())
  progressNoteId Int
  progressNote   PatientProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)

  discipline         String?                     @default("")
  reviewIntervention String?                     @default("")
  followUpRequired   DischargeFeedingAssistance?

  @@index([progressNoteId])
}

// ── ProgressNote child: additional notes ──
model ProgressNoteAdditionalNote {
  id             Int                 @id @default(autoincrement())
  progressNoteId Int
  progressNote   PatientProgressNote @relation(fields: [progressNoteId], references: [id], onDelete: Cascade)

  date          String? @default("")
  time          String? @default("")
  note          String? @default("")
  clinicianName String? @default("")

  @@index([progressNoteId])
}

// ═════════════════════════════════════════════════════════════
// 13. HOSPICE NURSING ASSESSMENT
// ═════════════════════════════════════════════════════════════
model HospiceNursingAssessment {
  id Int @id @default(autoincrement())

  // Relationships
  patientId Int
  patient   Patient @relation(fields: [patientId], references: [id])

  assessmentDate    DateTime @default(now())
  assessedByStaffId Int?
  assessedByStaff   Staff?   @relation("HospiceNursingAssessedBy", fields: [assessedByStaffId], references: [id])

  // ── General Observation ──
  levelOfConsciousness HospiceConsciousness?
  orientation          HospiceOrientation[]       @default([])
  generalAppearance    HospiceGeneralAppearance[] @default([])

  // ── Section C: Vital Signs ──
  bloodPressure    String?
  pulseRate        Float?
  respiratoryRate  Float?
  temperature      Float?
  oxygenSaturation Float?
  weightKg         Float?
  heightCm         Float?

  // ── Section D: Pain ──
  painPresent         Boolean?
  painScore           Int?
  painLocation        String[] @default([])
  painLocationOther   String?
  painCharacteristics String[] @default([])
  painReliefMeasures  String[] @default([])
  painReliefOther     String?

  // ── Section E: Respiratory ──
  breathingPattern HospiceBreathingPattern?
  dyspneaSeverity  HospiceDyspneaSeverity?
  oxygenTherapy    Boolean?
  oxygenFlowRate   String?
  cough            HospiceCoughType?
  sputumColor      HospiceSputumColor?
  respiratoryNotes String?

  // ── Section F: Cardiovascular ──
  pulseRhythm     HospicePulseRhythm?
  peripheralEdema HospiceEdemaSeverity?
  edemaLocation   String?
  skinColor       HospiceSkinColor?

  // ── Section G: Gastrointestinal ──
  appetite          HospiceAppetite?
  nausea            HospiceNauseaSeverity?
  vomiting          Boolean?
  vomitingFrequency String?
  bowelFunction     HospiceBowelFunction?
  lastBowelMovement DateTime?

  // ── Section H: Genitourinary ──
  urinaryFunction HospiceUrinaryFunction?
  urineAppearance HospiceUrineAppearance?

  // ── Section I: Skin ──
  skinIntegrity         HospiceSkinIntegrity?
  pressureInjuryRisk    HospicePressureInjuryRisk?
  pressureUlcerPresent  Boolean?
  pressureUlcerLocation String?
  pressureUlcerStage    HospicePressureUlcerStage?

  // ── Section J: Mobility ──
  mobilityStatus        HospiceMobilityStatus?
  fallRisk              HospiceFallRisk?
  assistiveDevices      HospiceAssistiveDevice[] @default([])
  assistiveDevicesOther String?

  //activity of daily living
  feeding   ADL?
  bathing   ADL?
  dressing  ADL?
  toileting ADL?
  mobility  ADL?

  // ── Section L: Psychological ──
  emotionalStatus      HospiceEmotionalStatus?
  communicationAbility HospiceCommunicationAbility?
  cognitiveStatus      HospiceCognitiveStatus?

  // ── Section M: Family / Caregiver ──
  primaryCaregiverName         String?
  primaryCaregiverRelationship String?
  primaryCaregiverPhone        String?
  familySupport                HospiceFamilySupport?
  caregiverStressLevel         HospiceCaregiverStress?

  // ── Section N: Spiritual / Cultural ──
  spiritualSupportRequested Boolean?
  religiousAffiliation      HospiceReligiousAffiliation?
  religiousAffiliationOther String?
  culturalConsiderations    String?

  // ── Section O: Nursing Diagnoses ──
  nursingDiagnoses      HospiceNursingDiagnosis[] @default([])
  nursingDiagnosesOther String?

  // ── Section Q: Nurse's Summary ──
  nurseSummary String?

  // ── Meta ──
  createdBy      Int
  createdByStaff Staff @relation("HospiceNursingCreatedBy", fields: [createdBy], references: [id])

  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  updatedBy      Int?
  updatedByAdmin Admin?   @relation("HospiceNursingUpdatedBy", fields: [updatedBy], references: [id])

  deletedAt           DateTime?
  deletedBy           Int?
  deletedByAdmin      Admin?             @relation("HospiceNursingDeletedBy", fields: [deletedBy], references: [id])
  deletionReason      String?
  hospitalAdmission   HospitalAdmission? @relation(fields: [hospitalAdmissionId], references: [id])
  hospitalAdmissionId Int?

  @@index([patientId, assessmentDate])
  @@index([createdBy])
}
