{
  "compilerOptions": {
    "target": "ES2020",
    "module": "commonjs",
    "lib": ["ES2020"],
    "outDir": "./dist",
    "rootDir": "./src",
    "strict": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "paths": {
      "@/*":              ["./src/*"],
      "@config/*":        ["./src/config/*"],
      "@controllers/*":   ["./src/controllers/*"],
      "@models/*":        ["./src/models/*"],
      "@routes/*":        ["./src/routes/*"],
      "@schemas/*":       ["./src/schemas/*"],
      "@services/*":      ["./src/services/*"],
      "@types/*":         ["./src/types/*"],
      "@utils/*":         ["./src/utils/*"],
      "@constants/*":     ["./src/constants/*"],
      "@middlewares/*":   ["./src/middlewares/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}