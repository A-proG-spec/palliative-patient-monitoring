{
  "compilerOptions": {
    // ── Target / module system ──
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],

    // ── THE FIX for all "Cannot find name 'process'" errors ──
    "types": ["node"],

    // ── Output ──
    "outDir": "./dist",
    "rootDir": "./src",
    "declaration": false,
    "declarationMap": false,
    "sourceMap": true,

    // ── Interop ──
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,

    // ── Strictness (kept as you had them) ──
    "strict": false,
    "noImplicitAny": false,
    "strictNullChecks": false,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,

    // ── Path aliases ──
    "baseUrl": ".",
    "paths": {
      "@/*":              ["./src/*"],
      "@config/*":        ["./src/config/*"],
      "@controllers/*":   ["./src/controllers/*"],
      "@models/*":        ["./src/models/*"],
      "@routes/*":        ["./src/routes/*"],
      "@schemas/*":       ["./src/schemas/*"],
      "@services/*":      ["./src/services/*"],
      "@types/*":         ["./src/types/*"],
      "@utils/*":         ["./src/utils/*"],
      "@constants/*":     ["./src/constants/*"],
      "@middlewares/*":   ["./src/middlewares/*"],
      "@lib/*":           ["./src/lib/*"]
    }
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}